# Copia este archivo a `.env` y completa los valores. `.env` NO se sube a Git (está en .gitignore).
# Este archivo de ejemplo no contiene ningún valor real.

# Secreto con el que se seudonimizan las llaves de usuario (obligatorio para construir Silver).
# Usa un valor largo y aleatorio, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si lo cambias, TODOS los seudónimos cambian (rompe la continuidad histórica). Guárdalo en un gestor de secretos.
PSEUDONIMO_SECRETO=

# Rutas (opcional; por defecto ./datos_red y ./lake)
DATA_DIR=
LAKE_DIR=

# Kafka de desarrollo (sin autenticación; solo para uso local). En producción: TLS y SASL.
KAFKA_BOOTSTRAP=localhost:9092

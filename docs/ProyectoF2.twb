      <column caption='Zonas Sin Servicio' datatype='real' name='[Calculation_1804353618501632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IIF([sin_servicio], 1, 0) )&#13;&#10;/&#13;&#10;COUNTD([zona_id (agg_cobertura_zona)])' />
      </column>
      <column caption='Zonas Con Servicio' datatype='real' name='[Calculation_1804353620443137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IIF(NOT [sin_servicio], 1, 0) )&#13;&#10;/&#13;&#10;COUNTD([zona_id (agg_cobertura_zona)])' />
      </column>
      <column caption='Con o Sin Servicio' datatype='string' name='[Calculation_1804353622708226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([sin_servicio], &quot;Sin servicio&quot;, &quot;Con servicio&quot;)' />
      </column>
